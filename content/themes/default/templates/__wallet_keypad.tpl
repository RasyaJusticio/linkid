<div class="keypad-wrapper">
  <div class="keypad-input">
    <input type="password" name="{$keypad_name}" id="{$keypad_id}" placeholder="••••••" autofocus="on" autocomplete="off" max="6">
  </div>

  <div class="keypad-buttons">
    <button type="button" class="btn btn-primary" data-amount="1">1</button>
    <button type="button" class="btn btn-primary" data-amount="2">2</button>
    <button type="button" class="btn btn-primary" data-amount="3">3</button>

    <button type="button" class="btn btn-primary" data-amount="4">4</button>
    <button type="button" class="btn btn-primary" data-amount="5">5</button>
    <button type="button" class="btn btn-primary" data-amount="6">6</button>

    <button type="button" class="btn btn-primary" data-amount="7">7</button>
    <button type="button" class="btn btn-primary" data-amount="8">8</button>
    <button type="button" class="btn btn-primary" data-amount="9">9</button>

    <div></div>
    <button type="button" class="btn btn-primary" data-amount="0">0</button>
    <button type="button" class="btn btn-primary" data-action="BACKSPACE">
      <i class="fas fa-backspace"></i>
    </button>
  </div>
</div>
